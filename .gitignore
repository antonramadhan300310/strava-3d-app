# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts

# Local env
.env
.env*.local

# OS / editor
.DS_Store
*.log

# Native build artifacts (the android/ project itself stays tracked)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

# OTA artifacts produced by the release workflow
/allmova-ota-bundle.zip
/allmova-latest.apk
/version.json

# Security audit output (scripts/security writes here when run locally)
/reports/

# TypeScript incremental build info
*.tsbuildinfo

# Android signing keys (never commit)
*.jks
*.keystore

# Python bytecode (scripts/security)
__pycache__/
*.pyc
